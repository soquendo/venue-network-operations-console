# Copy this example to .env for local configuration; never commit the private .env.
# Before incident-data is first initialized, choose and preserve a local-only
# VENUE_INCIDENT_DB_PASSWORD. For an existing volume, reuse the SAME password.
# Changing POSTGRES_PASSWORD in Compose/environment does not rotate the database
# role's stored password. Rotate explicitly in PostgreSQL first, then update .env.
VENUE_INCIDENT_DB_PASSWORD=replace-with-a-local-only-password
